{
  "manifest_version": 2,
  "name": "Cites Extractor",
  "version": "0.3.0",
  "description": "Saves the papers linked from a web page, or cited in a PDF's bibliography, into Zotero.",
  "browser_specific_settings": {
    "gecko": {
      "id": "perplexity2zotero@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/pdf.min.js",
      "extract.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Cites Extractor: send linked / cited papers to Zotero",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
