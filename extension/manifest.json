{
  "manifest_version": 2,
  "name": "Perplexity2Zotero",
  "version": "0.1.0",
  "description": "Opens every link on the current page and asks the Zotero Connector to save it.",
  "browser_specific_settings": {
    "gecko": { "id": "perplexity2zotero@example.local", "strict_min_version": "109.0" }
  },
  "permissions": ["tabs", "activeTab", "management", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Send all links to Zotero" }
}
